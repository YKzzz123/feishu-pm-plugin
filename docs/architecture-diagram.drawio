        </mxCell>
        <mxCell id="s2" value="2. 解析身份与项目&#xa;open_id→user&#xa;chat→project / 显式 code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="260" y="100" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. authorize&#xa;user × project × action&#xa;（业务表 role 矩阵）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4. 用户确认&#xa;或周报 Y&#xa;（产品第二道门）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="700" y="100" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5. 飞书 ACL&#xa;re-check&#xa;（写前复核）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="100" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="6. OpenAPI 写出&#xa;+ operations 幂等&#xa;+ audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1090" y="100" width="160" height="70" as="geometry" />
        </mxCell>

        <mxCell id="a12" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a23" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a34" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a45" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a56" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Deny paths -->
        <mxCell id="deny" value="任一步失败 → 拒绝出站写飞书（返回结构化 error.code）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;fontSize=12;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="400" y="210" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ad3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1;dashed=1;strokeColor=#b85450;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="deny"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ad4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1;dashed=1;strokeColor=#b85450;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="deny"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ad5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeWidth=1;dashed=1;strokeColor=#b85450;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="deny"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Two permission layers -->
        <mxCell id="perm-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="560" height="200" as="geometry" />
        </mxCell>
        <mxCell id="perm-t" value="两套权限（勿混）" style="text;html=1;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="perm-a" value="A. Hermes 宿主&#xa;· plugins enable&#xa;· allowlist（谁能跟 Bot 说话）&#xa;· capabilities&#xa;→ 只决定「插件开没开」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="340" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="perm-b" value="B. 业务 authorize&#xa;· group_members.role&#xa;· 一群一组 chat 绑定&#xa;· 写前飞书 Drive ACL&#xa;→ 决定「这人在这组能不能做」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="350" y="340" width="250" height="120" as="geometry" />
        </mxCell>

        <!-- Memory box -->
        <mxCell id="mem-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#999999;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="660" y="290" width="590" height="200" as="geometry" />
        </mxCell>
        <mxCell id="mem-t" value="三类记忆分存" style="text;html=1;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="680" y="300" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="mem1" value="① 会话 transcript&#xa;Hermes session&#xa;（非权限真源）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="680" y="340" width="170" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mem2" value="② 偏好记忆&#xa;MEMORY.md 等&#xa;MVP 慎用&#xa;禁止当 ACL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="870" y="340" width="160" height="120" as="geometry" />
        </mxCell>
        <mxCell id="mem3" value="③ 业务状态&#xa;PostgreSQL&#xa;成员/周报/幂等/审计&#xa;← 系统真源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1050" y="340" width="180" height="120" as="geometry" />
        </mxCell>

        <!-- Roles -->
        <mxCell id="role-t" value="角色 → action（示意）" style="text;html=1;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="220" height="24" as="geometry" />
        </mxCell>
        <mxCell id="role-table" value="owner：读 · 上传 · 管成员 · 周报审批 ·（Y 后）写 Wiki&#xa;member：读 · 上传&#xa;viewer：只读上下文&#xa;未知 action → Deny（fail-closed）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="550" width="580" height="100" as="geometry" />
        </mxCell>
        <mxCell id="bind-note" value="一群一组：chat_id UNIQUE → group_id&#xa;Hermes session ≠ 组绑定（两层）&#xa;DM 须显式 group_code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf6e8;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="680" y="550" width="570" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="business-flows" name="主功能链路">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t3" value="主功能链路时序（简化）" style="text;html=1;fontSize=18;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="500" y="20" width="400" height="30" as="geometry" />

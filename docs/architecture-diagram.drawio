        <mxCell id="b3" value="draft + token&#xa;不写飞书" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="340" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="展示草稿" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="85" width="90" height="36" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="确认上传" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="85" width="90" height="36" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="commit+幂等" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="840" y="205" width="100" height="36" as="geometry" />
        </mxCell>
        <mxCell id="b7" value="auth+ACL&#xa;写状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="980" y="340" width="100" height="40" as="geometry" />

        <mxCell id="eb1" style="html=1;strokeWidth=1.5;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb2" style="html=1;strokeWidth=1.5;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb3" style="html=1;strokeWidth=1.5;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="b3" target="b4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb4" style="html=1;strokeWidth=1.5;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="b4" target="b5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb5" style="html=1;strokeWidth=1.5;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="b5" target="b6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb6" style="html=1;strokeWidth=1.5;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="b6" target="b7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eb7" style="html=1;strokeWidth=1.5;endArrow=block;endFill=1;edgeStyle=orthogonalEdgeStyle;rounded=1;" edge="1" parent="1" source="b7" target="b8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Flow weekly -->
        <mxCell id="fw-title" value="链路 C–E：周提醒 / 汇总 / 审批 → Wiki" style="text;html=1;fontStyle=1;fontSize=13;fontColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="180" y="560" width="360" height="24" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="Cron&#xa;Wed/Thu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="600" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="w2" value="remind&#xa;若 none" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="310" y="600" width="90" height="40" as="geometry" />
        </mxCell>

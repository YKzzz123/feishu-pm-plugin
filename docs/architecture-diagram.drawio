        <!-- Flow B: upload -->
        <mxCell id="fb-title" value="链路 B：对话上传 Drive" style="text;html=1;fontStyle=1;fontSize=13;fontColor=#1a7a1a;" vertex="1" parent="1">
          <mxGeometry x="180" y="60" width="220" height="24" as="geometry" />
